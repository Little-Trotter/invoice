
# Environment / secrets – never commit these files
.env
.env.local

# Future: file-based secrets directory (for Docker Compose secrets: feature)
secrets/

# Certificate and key material – NEVER commit (TS-4)
# These files contain cryptographic material and must be protected
*.pem
*.key
*.crt
*.cer
*.cert
*.p12
*.pfx
*.jks
*.p8
*.pub

# IDE and local tooling
.idea/
.vscode/
.copilot-tmp/

# Personal scratch/todo notes — never commit
*.do

# Generated demo data (make datagen) – seed-deterministic, regenerated on demand.
# The trailing /* (not /) matters: git does not descend into an excluded directory,
# so a negation below an excluded `datagen/receipts/` would never take effect and the
# committed boundary fixtures (IR-8) would silently stop being addable.
datagen/receipts/*
!datagen/receipts/boundaries/
scripts/load-demo-data.sql

# Generic local artifacts
kotlin-invoice/target/
.sonar-export/
**/logs/
**/log/
**/tmp/
**/temp/
**/.cache/
*.log
# Copilot/Claude: do not index secrets, .env, or logfiles

.aider*

# GitHub Copilot / Copilot CLI
.copilot/
.copilot-tmp/
.copilot-*

# Anthropic Claude
.claude/
claude-*

# Kilo Code
.kilo/
.kilocode/
.opencode/
.pi/
.zed/

# Continue
.continue/

# JetBrains IDE module files (loose .iml outside .idea/)
*.iml

# Ollama
.ollama/
ollama-*

# Generic LLM tooling & vector DB artifacts
.embeddings/
.vectorstore/
chroma.db
chroma-*
faiss.index
*.embedding
*.llm
conversations/
sessions.json

# Ignore Maven snapshot artifacts and build outputs
**/*-SNAPSHOT.jar
**/*-SNAPSHOT.*
**/target/
/kotlin-invoice/src/main/frontend/generated/
# Vaadin dev-mode output written by the e-mail browser suite; email-app itself has no Vaadin UI.
/kotlin-email/email-e2e-tests/src/main/frontend/
/kotlin-email/email-e2e-tests/src/main/bundles/

# Qodana scan results (auto-generated, not to be tracked)
**/*.sarif.json

# Generated SBOM markdown (regenerate via scripts/generate_sbom_md.py from the Dagger Sbom() output)
sbom.md

# task13-N4 — compiled binary of the standalone journal verifier, built on demand
/ci/numberjournal-verify/numberjournal-verify

.hermes/

# Raspberry Pi image builder (admin-tools/scripts/server) — local config, downloads, built images, credentials
admin-tools/scripts/server/image.conf
admin-tools/scripts/server/work/
admin-tools/scripts/server/out/

# npm/tooling — never track dependency trees
node_modules/
opencode.json

# Qodana-Scan-Artefakte (Coverage-Import-Verzeichnis, Bootstrap-erzeugt)
.qodana/

# Generated by the linters this repo's own gates run (ruff via
# ci/scripts/quality/lint-config.sh) and by pytest. Both were sitting untracked
# AND unignored in the working tree, which is the worst of both: noise in
# `git status` that nobody can act on.
.pytest_cache/
.ruff_cache/

# macOS Finder metadata — never content, always noise.
.DS_Store

# Python-Bytecode — entsteht bei jedem py_compile/Import, gehoert nie ins Repository
__pycache__/
*.py[cod]
