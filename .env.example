# ─────────────────────────────────────────────────────────────────────────────
# little-trotter-invoice - Credentials & Configuration Template
#
# 1. Copy to .env:          cp .env.example .env
#    OR generate strong passwords automatically (make dev does this when .env is missing):
#                           ci/scripts/dev/setup-secrets.sh
#
# 2. Validate your .env:    ci/scripts/dev/setup-secrets.sh --check  (make dev runs it too)
#
# Docker Compose automatically loads .env from the project root.
# The .env file is excluded from git via .gitignore – never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=little_trotter_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=little-trotter-db
POSTGRES_PORT=5432
# RS-7 (M2, Postgres role separation) — POSTGRES_USER above is bootstrap/provisioning only;
# no service connects with it anymore. docker/postgres/init-roles.sh creates these two
# non-superuser roles on first container start: lt_migrator runs Flyway (DDL, owns the
# schema), lt_app is the app/job-worker/datagen runtime (DML only — and only INSERT/SELECT
# on number_journal, see V1__baseline_schema.sql section 13).
LT_MIGRATOR_DB_PASSWORD=CHANGE_ME
LT_APP_DB_PASSWORD=CHANGE_ME

# ── RustFS Object Storage (S3-compatible) ──────────────────────────────────────
RUSTFS_ACCESS_KEY=little-trotter-rustfs
RUSTFS_SECRET_KEY=CHANGE_ME
INVOICE_DOCUMENT_BUCKET=little-trotter-documents

# ── Build/Quality Toggles (optional) ─────────────────────────────────────────
# If OPEN_SOURCE=true and QUALITY=false, make test skips strict quality gates.
# Lowercase aliases are also supported: open_source / quality
OPEN_SOURCE=false
QUALITY=true

# ── Optional Service Image Overrides ──────────────────────────────────────────
# KoSIT-Validator ist seit Task M eingebettet (kotlin-xpdf) — kein Container mehr.

# ── LLM-Validierung (optional, oMLX auf dem Host) ──────────────────────────────
# Läuft lokal auf dem Host (oMLX, OpenAI-kompatibles API auf Port 8020 auf diesem
# Mac) — nicht als Docker-Service verwaltet. Leer lassen = LLM-Schritt deaktiviert
# (kein Fehler, kein Absturz).
MLX_ENDPOINT=http://host.docker.internal:8020/v1
# Bearer-Token aus ~/.omlx/settings.json (auth.api_key) — NICHT committen, hier leer lassen.
MLX_API_KEY=
# Ein Modell — die lokale Engine laedt genau ein Modell in den Speicher.
MLX_MODEL=Qwen3.6-35B-A3B-8bit
# Timeout in Sekunden (Kaltstart der Gewichte kann Minuten dauern).
MLX_TIMEOUT=300

# ── NATS JetStream (internal Docker network) ───────────────────────────────────
NATS_URL=nats://nats:4222


# ── Valkey (Redis-protocol-compatible, invoice PDF/query cache) ────────────────
VALKEY_PASSWORD=CHANGE_ME

# ── RS-9: Archive-package signing key (xpdf worker only) ───────────────────────
# Ed25519 keypair, base64 DER (PKCS8 private / X.509 SubjectPublicKeyInfo public). Never set
# these by hand — generated together by scripts/dev/setup-secrets.sh (openssl), which also
# writes the public half out as archive-signing-public-key.pem for handing to an auditor.
ARCHIVE_ED25519_PRIVATE_KEY=CHANGE_ME
ARCHIVE_ED25519_PUBLIC_KEY=CHANGE_ME

# ── Optional: goauthentik (TS-2 — only needed if you opt into docker/compose/auth.yml) ──────────
# The app's OIDC login (authorization code flow + PKCE) is wired against this Authentik instance
# once the overlay is applied — see docs/AUTH_SETUP.md and kotlin-invoice's application.properties
# "Authentication" section. These variables are only read by the optional overlay compose file and
# by the app when AUTH_ENABLED (below) is true. No host port: reached at
# https://${PUBLIC_DOMAIN}/auth/ through Caddy, never directly (docker/compose/auth.yml).
# First login after bootstrap: https://${PUBLIC_DOMAIN}/auth/if/flow/initial-setup/ (User: akadmin)
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_DB_PASSWORD=CHANGE_ME
AUTHENTIK_POSTGRES_DB=little-trotter-auth
AUTHENTIK_BOOTSTRAP_EMAIL=admin@little-trotter.local
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME
# The app's own OIDC client registered in Authentik (docker/authentik/blueprints/
# little-trotter-invoice.yaml provisions it non-interactively with these exact values).
AUTHENTIK_OIDC_CLIENT_ID=little-trotter-invoice
AUTHENTIK_OIDC_CLIENT_SECRET=CHANGE_ME

# ── Authentication dev bypass (TS-2) ────────────────────────────────────────────────────────────
# Default true (auth enforced) for a real deployment (docker/compose/deploy.yml); leave unset for
# `make dev` — %dev/%test in application.properties already default it to false there. Only set
# this explicitly to force a non-default value for a specific container/environment.
# AUTH_ENABLED=true

# ── External SonarQube ──────────────────────────────────────────────────────
# Sonar is executed against an external SonarQube instance via `make sonar`.
SONAR_HOST_URL=https://sonarqube.example.com
SONAR_TOKEN=
# Optional: default Sonar project key (used for all modules if module-specific keys are empty)
SONAR_PROJECT_KEY=de.littletrotter:little-trotter-invoice-parent
# Optional: module-specific overrides
SONAR_PROJECT_KEY_INVOICE=
SONAR_PROJECT_KEY_SHARED=
SONAR_PROJECT_KEY_XPDF=

# ── Backup Configuration (Task J) ─────────────────────────────────────────────
# Base directory for backups (must be writable by the container)
BACKUP_BASE_DIR=/backups/little-trotter
# Retention: number of daily backups to keep (default 7)
BACKUP_KEEP_DAILY=7
# Retention: number of weekly backups to keep (default 4)
BACKUP_KEEP_WEEKLY=4

# ── Monitoring (Grafana/Prometheus, ADM-11 — admin-tools/monitoring/) ──────────
# Grafana admin login (anonymous access disabled). Read by
# admin-tools/monitoring/docker-compose.yml — start with:
# make -C admin-tools monitoring CMD=up
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Caddy TLS Reverse Proxy (TS-1) ────────────────────────────────────────────
# Certificate issuer mode:
# - internal: Caddy's built-in CA for LAN/offline use — export the root CA
#             once to client devices (see docs/tls-security/)
# - acme:     automatic HTTPS via Let's Encrypt; PUBLIC_DOMAIN must be
#             reachable from the internet on ports 80/443
TLS_MODE=internal

# Domain the proxy serves and requests certificates for.
# Examples: invoice.example.com (acme), little-trotter.local (internal/LAN).
# With enforced login (auth.yml overlay) this must be a REAL hostname, never
# `localhost`: the app resolves the public origin container-internally via a
# network alias, and localhost always wins against any alias there — OIDC
# discovery would hit the app's own loopback and fail.
PUBLIC_DOMAIN=little-trotter.local

# ACME account contact for expiry notices; only used with TLS_MODE=acme,
# may stay empty.
ACME_EMAIL=


# ── Optional: email component (only needed if you opt into docker/compose/email.yml) ─────────────
# The email component (little-trotter-email) is a separate deployable with its own database,
# bucket, NATS streams and Valkey database index. It is STRICTLY OPTIONAL, exactly like the
# Factur-X engine: `make dev EMAIL=1` in the admin-tools repo is the opt-in, and a stack started
# without it carries none of it — no container, no schema, no bucket, no stream, no menu entry.
#
# The secrets below are NOT generated by this repo's setup-secrets.sh. They are written only when
# the component is enabled (`make secrets EMAIL=1` in admin-tools, its scripts/dev/setup-secrets.sh), so an
# instance that never wants email never grows an unused SMTP credential or signing key.
#
# For a native prod/test/demo instance these values live in /etc/little-trotter/<instance>.env
# instead (template: admin-tools/scripts/server/instance.env.example), where `lt-setup`'s email
# step writes them; this file is the DEV template only.

# Master switch. Off by default — everything below is ignored while this is false.
LT_MAIL_ENABLED=false

# Own database and roles in the shared cluster. Postgres roles are cluster-wide, so on a shared
# server these are instance-suffixed (mail_app_prod / mail_app_test / …), the same convention
# LT_APP_DB_USER follows.
MAIL_APP_DB_PASSWORD=CHANGE_ME
MAIL_MIGRATOR_DB_PASSWORD=CHANGE_ME

# Own bucket and its OWN key pair — the invoicing app must not be able to read the mail archive,
# and the component must not be able to read invoice documents.
MAIL_S3_BUCKET=mail-journal
MAIL_S3_ACCESS_KEY=little-trotter-mail
MAIL_S3_SECRET_KEY=CHANGE_ME

# Service-to-service auth for the compose handover (POST /mail/api/compose). The invoicing app
# sends this as a bearer token; the endpoint is never reachable from outside (Caddy answers 404
# for /mail/api/*).
MAIL_INTEGRATION_TOKEN=CHANGE_ME

# Provider mailbox. In the dev stack these point at Mailpit and need neither TLS nor auth.
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=rechnung@example.invalid
MAIL_FROM_NAME=Little Trotter

# Ed25519 keypair signing every mail archive package. Deliberately SEPARATE from the xpdf worker's
# ARCHIVE_ED25519_* pair above, so the component can be installed, rotated and removed without
# touching the invoice export key — verification tooling needs both public keys.
MAIL_ARCHIVE_ED25519_PRIVATE_KEY=CHANGE_ME
MAIL_ARCHIVE_ED25519_PUBLIC_KEY=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Container memory limits (docker-compose.yml)
#
# Every value below has a working default sized for this compose file's own stated minimum
# target: the dev/eval stack (see docker-compose.yml's own header comment) running its whole
# stack — postgres/rustfs/nats/valkey/little-trotter-invoice/little-trotter-job-worker/
# kotlin-xpdf — on an 8 GB Raspberry Pi 5. None of these need setting for that target; only
# override on a bigger box or if `docker stats` shows a service actually needs more.
#
# LT_XPDF_MEMORY_LIMIT (default 2048M) also sizes kotlin-xpdf's JOB_WORKER_THREADS: the heap is
# 75 % of the limit (MaxRAMPercentage), bulk threads = (heap - 500 MiB boot - 256 MiB receipt reserve - 150 MiB for the
# interactive thread) / 150 MiB per thread (xpdf.jobs.per-thread-render-mib), minimum 1. The
# default 2048M gives a 1536M heap and 4 bulk + 1 interactive thread — raising the limit is the fix for "bulk e-invoice
# re-issue got much slower after 2026-09-18's capacity fix", not a code change.
#
# PO-agreed values for demo/test/prod's own separate, hardened stack (16 GB host, 2026-09-18) —
# NOT set here, that stack lives in the private workshop/admin-tools repo, not this file:
#   LT_INVOICE_MEMORY_LIMIT=3072M   LT_XPDF_MEMORY_LIMIT=2880M (→ 2160M heap, 3 bulk threads)
#   LT_POSTGRES_MEMORY_LIMIT=2048M  LT_RUSTFS_MEMORY_LIMIT=512M
#   LT_NATS_MEMORY_LIMIT=256M       LT_VALKEY_MEMORY_LIMIT=512M
# ─────────────────────────────────────────────────────────────────────────────
# LT_INVOICE_MEMORY_LIMIT=2200M
# LT_XPDF_MEMORY_LIMIT=3072M
# LT_POSTGRES_MEMORY_LIMIT=768M
# LT_RUSTFS_MEMORY_LIMIT=256M
# LT_NATS_MEMORY_LIMIT=128M
# LT_VALKEY_MEMORY_LIMIT=384M
# LT_JOB_WORKER_MEMORY_LIMIT=384M
