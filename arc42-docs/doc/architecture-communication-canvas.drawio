        <mxCell id="value" value="&lt;font color=&#x27;#1A73E8&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Value Proposition&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Compliant E-Invoicing&lt;/b&gt;: Turnkey EN 16931, XRechnung, and ZUGFeRD generation with PDF/A-3b output, optionally sent by e-mail.&lt;br&gt;• &lt;b&gt;Sovereign Local-First&lt;/b&gt;: Self-hosted on small-budget hardware (mini PC or Linux server) with zero cloud dependency.&lt;br&gt;• &lt;b&gt;Integrated Storage&lt;/b&gt;: S3-compatible document store (RustFS) for durable receipts.&lt;br&gt;• &lt;b&gt;Domain-Aligned UX&lt;/b&gt;: User-friendly German interface, change-tracking invoices, organized catalogs, and sender/recipient management.&lt;br&gt;• &lt;b&gt;Reference Prototype&lt;/b&gt;: Fully functional prototype reference architecture under Apache-2.0 / CC BY 4.0." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="290" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="value-bar" value="" style="rounded=0;html=1;fillColor=#1A73E8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="functions" value="&lt;font color=&#x27;#8E24AA&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Core Functions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Master Data Management&lt;/b&gt;: Aggregates for issuers, recipients, items, and tax/B2B configurations.&lt;br&gt;• &lt;b&gt;Invoice Lifecycle&lt;/b&gt;: State engine (draft, issued, cancelled) with immutable snapshots on issue.&lt;br&gt;• &lt;b&gt;Asynchronous Pipeline&lt;/b&gt;: Decoupled PDF/A-3b rendering and ZUGFeRD XML embedding in kotlin-xpdf.&lt;br&gt;• &lt;b&gt;Multi-Stage Validation&lt;/b&gt;: Strict structural XML schema, Schematron, and KoSIT validator enforcement.&lt;br&gt;• &lt;b&gt;Receipts &amp; Auditing&lt;/b&gt;: Deduplicated receipt intake, S3 archiving, and basic statistics.&lt;br&gt;• &lt;b&gt;Mail Dispatch (optional)&lt;/b&gt;: Templates, SMTP submission, append-only send journal, signed archive package, and SMTP journal-copy handover of every sent mail to the operator&#x27;s mail archive (status in the journal) in kotlin-email; compose, journal and template views in the invoicing UI." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="290" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="functions-bar" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="decisions" value="&lt;font color=&#x27;#F4511E&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Core Decisions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;ADR-001 (Deterministic Money Math)&lt;/b&gt;: Dedicated Money value type with 4-decimal accumulation and ArchUnit-gated BigDecimal prohibition.&lt;br&gt;• &lt;b&gt;ADR-002 (EN 16931 Business Terms)&lt;/b&gt;: B2bTerm Kotlin enum over seeded database catalog; compile-time safety for all e-invoicing terms.&lt;br&gt;• &lt;b&gt;ADR-007 (S3 API Object Storage)&lt;/b&gt;: RustFS (S3-compatible) for receipts and documents; open for cloud migration to any managed Postgres + S3 API.&lt;br&gt;• &lt;b&gt;ADR-015 (Mail as Self-Contained System)&lt;/b&gt;: Mail dispatch with own image, schema, bucket, and UI; coupled only via the frozen kotlin-mail-contract over NATS/REST.&lt;br&gt;• &lt;b&gt;ADR-020 (Small-Budget Event Backbone)&lt;/b&gt;: NATS JetStream job envelopes over a heavyweight Kafka cluster; durable event flow on mini-PC hardware." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="290" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="decisions-bar" value="" style="rounded=0;html=1;fillColor=#F4511E;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="6" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="technologies" value="&lt;font color=&#x27;#E65100&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Technologies&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Application Layer&lt;/b&gt;: Kotlin 2.x, Java 25, Quarkus 3.x, Vaadin 25.&lt;br&gt;• &lt;b&gt;Data &amp; Storage&lt;/b&gt;: PostgreSQL 18 (JPA / Flyway), Valkey (caching), RustFS (S3-compatible object store).&lt;br&gt;• &lt;b&gt;Messaging Backbone&lt;/b&gt;: NATS JetStream (asynchronous generation envelopes and maintenance events).&lt;br&gt;• &lt;b&gt;PDF &amp; Validation&lt;/b&gt;: Typst (sole PDF/A-3b layout engine), Mustang Project (ZUGFeRD/CII), embedded KoSIT validator, veraPDF (standalone conformance container).&lt;br&gt;• &lt;b&gt;Mail&lt;/b&gt;: SMTP submission, journal copy to the operator&#x27;s archive address (envelope recipient, ADR-037), Ed25519-signed archive packages, Mailpit in tests.&lt;br&gt;• &lt;b&gt;Deployment &amp; Ops&lt;/b&gt;: Docker Compose, Caddy (TLS), systemd native services, and Go-based lt CLI suite." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="90" width="290" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="technologies-bar" value="" style="rounded=0;html=1;fillColor=#E65100;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="940" y="90" width="6" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="stakeholders" value="&lt;font color=&#x27;#188038&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Key Stakeholders&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Office Manager / Owner&lt;/b&gt;: Prepares and issues invoices, manages master data, and tracks receipts.&lt;br&gt;• &lt;b&gt;Invoice Recipient&lt;/b&gt;: Receives legal hybrid PDF/A-3b invoices and structured business transaction XML.&lt;br&gt;• &lt;b&gt;Tax Advisor / Auditor&lt;/b&gt;: Inspects GoBD-compliant e-invoice archives, receipt records, and financial reports.&lt;br&gt;• &lt;b&gt;DevOps / Operator&lt;/b&gt;: Provisions server, runs automated age backups, and manages deployments via lt CLI.&lt;br&gt;• &lt;b&gt;Developers and AI Agents&lt;/b&gt;: Maintain and evolve architecture under spec-first, gate-checked automation." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="290" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="stakeholders-bar" value="" style="rounded=0;html=1;fillColor=#188038;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="quality" value="&lt;font color=&#x27;#455A64&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Quality Requirements&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Norm Conformance&lt;/b&gt;: Validation against KoSIT and veraPDF.&lt;br&gt;• &lt;b&gt;Quality Gates&lt;/b&gt;: Mandatory 90% line and branch JaCoCo test gates across all backend and UI modules.&lt;br&gt;• &lt;b&gt;Comprehensive Coverage&lt;/b&gt;: Karibu headless view testing, monkey testing, and Playwright end-to-end suites.&lt;br&gt;• &lt;b&gt;Resource Thrift&lt;/b&gt;: Small-footprint services optimized for low-power hardware (~128 MiB NATS, lean JVM).&lt;br&gt;• &lt;b&gt;Accessibility &amp; Usability&lt;/b&gt;: ARIA keyboard navigation, dark mode support, and resilient state handling." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="290" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="quality-bar" value="" style="rounded=0;html=1;fillColor=#455A64;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="context" value="&lt;font color=&#x27;#1A73E8&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Business Context&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Target Audience &amp; Goal&lt;/b&gt;: Practical, zero-subscription e-invoicing for solo entrepreneurs, craft businesses, and freelancers; accessible open-source foundation (&quot;Linux for e-invoicing&quot;).&lt;br&gt;• &lt;b&gt;Legal Compliance Core&lt;/b&gt;: Generates legally mandated EN 16931 e-invoices (ZUGFeRD, XRechnung) and DIN 5008 PDF/A-3b without cloud SaaS lock-in or recurring license fees.&lt;br&gt;• &lt;b&gt;Honest Scope Limits&lt;/b&gt;: Dedicated strictly to invoice and receipt lifecycle; excludes Peppol AS4 networks, payment processing, and double-entry accounting.&lt;br&gt;• &lt;b&gt;Operating Model&lt;/b&gt;: Local-first single-operator system; Caddy reverse proxy terminates HTTPS, core data commits to PostgreSQL, document artifacts persist to S3/RustFS.&lt;br&gt;• &lt;b&gt;System Interfaces&lt;/b&gt;: Asynchronous PDF/XML worker pipeline via NATS JetStream; optional mail dispatch SCS (kotlin-email, email-app under /mail, SMTP) and out-of-band ops via lt CLI." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="590" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="context-bar" value="" style="rounded=0;html=1;fillColor=#1A73E8;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="components" value="&lt;font color=&#x27;#188038&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Components / Modules&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;kotlin-invoice&lt;/b&gt;: Core web application, Vaadin Flow UI, use cases behind per-use-case input ports, domain model, REST endpoints, JPA persistence, and PDFBox-based receipt normalization at upload.&lt;br&gt;• &lt;b&gt;kotlin-shared / kotlin-ui-components&lt;/b&gt;: Cross-cutting Money, DTOs, size-budget policy, B2B terms; shared Vaadin widgets (free-text editor).&lt;br&gt;• &lt;b&gt;kotlin-xpdf&lt;/b&gt;: Rendering/validation service — Typst, Mustang/CII, CII Schematron, KoSIT, asynchronous veraPDF integration.&lt;br&gt;• &lt;b&gt;kotlin-email (+ kotlin-mail-contract)&lt;/b&gt;: Optional mail SCS — email-core, email-service, headless deployable email-app (REST only; mail views live in the invoicing app); frozen published contract.&lt;br&gt;• &lt;b&gt;kotlin-e2e-tests / email-e2e-tests&lt;/b&gt;: Cross-module E2E suites on real Testcontainers (Postgres, NATS, RustFS, Mailpit).&lt;br&gt;• &lt;b&gt;little-trotter-admin-tools (sibling repo)&lt;/b&gt;: Operator tooling — Phase 1 shell automation and reference configs (MVP until Q4/2027); Phase 2 Go CLI suite (lt, lhorse) after phase-gate hardening; Playwright suite, monitoring, backups." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="550" width="590" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="components-bar" value="" style="rounded=0;html=1;fillColor=#188038;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="550" width="6" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="risks" value="&lt;font color=&#x27;#D93025&#x27;&gt;&lt;b style=&#x27;font-size:13px&#x27;&gt;Core Risks and Missing Information&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Regulatory Volatility&lt;/b&gt;: Ongoing changes to European e-invoicing standards, profiles, and validation rules.&lt;br&gt;• &lt;b&gt;Rendering Complexities&lt;/b&gt;: PDF/A-3b color profiling, font licensing, and dynamic page-break layout math.&lt;br&gt;• &lt;b&gt;Resource Headroom&lt;/b&gt;: Mini PC memory constraints requiring active resource limits and lean profiles.&lt;br&gt;• &lt;b&gt;Single-Maintainer Bus Factor&lt;/b&gt;: Mitigated by ArchUnit rules, conventional commits, and arc42 documentation.&lt;br&gt;• &lt;b&gt;Mail Integration&lt;/b&gt;: Separate SCS (kotlin-email) needs a frozen contract, durable NATS queues, and SMTP deliverability on self-hosted hardware." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#202124;fillColor=#FDF3F2;strokeColor=#D93025;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1190" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="risks-bar" value="" style="rounded=0;html=1;fillColor=#D93025;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="6" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
