<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.littletrotter</groupId>
    <artifactId>little-trotter-invoice-parent</artifactId>
    <version>0.9.59-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>de.littletrotter</groupId>
  <artifactId>kotlin-ui-components</artifactId>
  <packaging>jar</packaging>
  <name>kotlin-ui-components</name>
  <description>
    Vaadin Flow component jar shared by every host application in this repository: presentational
    widgets with no Quarkus/CDI dependency of their own, so a host wires them into whatever runtime
    it already has (same shape as kotlin-email's email-ui). First tenant: the free-text editor and
    its chip row, package de.littletrotter.ui.components.freetext.
  </description>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>de.littletrotter</groupId>
      <artifactId>kotlin-shared</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Flow components only (TextArea, Button, Div, Span, Icon…) — the host application supplies
         its own Vaadin servlet/session runtime; this module never boots a UI of its own. Version
         managed by the vaadin-bom import in the root pom. -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-core</artifactId>
    </dependency>

    <!-- ── Test ──────────────────────────────────────────────────────────── -->
    <!-- Karibu-Testing: unit-test Vaadin components WITHOUT browser or running server — same
         library and version kotlin-invoice's UI tests use. -->
    <dependency>
      <groupId>com.github.mvysny.kaributesting</groupId>
      <artifactId>karibu-testing-v24</artifactId>
      <version>${karibu-testing.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- @ParameterizedTest/@EnumSource (FreeTextEditingTest): kotlin-invoice/kotlin-xpdf get this
         transitively through their own quarkus-junit dependency; this module has none, so it needs
         the artifact directly. Pinned to the same 6.1.3 the root pom pins junit-jupiter-api/engine
         to (see that property's own comment: 6.1.x jupiter against a mismatched platform-commons
         breaks reflection at runtime). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <configuration>
          <jvmTarget>${maven.compiler.release}</jvmTarget>
          <!-- Kotlin-only call sites: no DefaultImpls compatibility classes for interface defaults
               (dead forwarders that JaCoCo counted as missed lines). -->
          <args>
            <arg>-jvm-default=no-compatibility</arg>
          </args>
        </configuration>
        <executions>
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <goals><goal>compile</goal></goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>process-test-sources</phase>
            <goals><goal>test-compile</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- ktlint and detekt linter gates (inherited from the root pom's pluginManagement) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
